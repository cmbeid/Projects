{
  "name": "alchemy-forge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A portrait-first HTML5 crafting puzzle game. Combine elements, discover a world.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx scripts/validate-data.ts",
    "icons": "tsx scripts/make-icons.ts",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify-ui.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
